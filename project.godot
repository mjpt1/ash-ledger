; Engine configuration file.
; Ash Ledger — Survivor + Story hybridcasual MVP

config_version=5

[application]

config/name="دفتر خاکستر"
config/description="بقا در شب خاکستر با داستان کوتاه و کوآپ آنلاین."
config/version="0.2.0"
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"

[autoload]

Locale="*res://scripts/systems/locale.gd"
SaveSystem="*res://scripts/systems/save_system.gd"
GameState="*res://scripts/systems/game_state.gd"
StoryLoader="*res://scripts/systems/story_loader.gd"
NetLobby="*res://scripts/systems/net_lobby.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=405
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep_width"
window/handheld/orientation=1

