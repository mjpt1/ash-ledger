{
  "name": "keepy-pro",
  "version": "1.0.0",
  "description": "روپایی پرو — بازی روپایی رقابتی موبایل",
  "private": true,
  "scripts": {
    "build:web": "node scripts/sync-www.js",
    "cap:sync": "npm run build:web && npx cap sync",
